---
/**
 * The launch sign-up, the focal point under the title scene, staged like
 * Wayfarer's new game intro: PROF. OAK (as FireRed and LeafGreen draw him)
 * stands on the intro's grey oval and throws out WOOPER (then the opening's
 * cast in turn), and asks for your
 * email on the naming screen the way the intro asks for your name.
 */
import { DialogBox } from "~/components/DialogBox"
import { OakStage } from "~/components/OakStage"
import SignupForm from "~/components/SignupForm.astro"
import { RELEASE_LABEL } from "~/lib/release"

import CtaLinks from "./CtaLinks.astro"
---

<section aria-labelledby="notify" class="relative mx-auto flex min-h-[90vh] max-w-6xl items-center px-6 pt-8 pb-24">
  <!-- On wide screens OAK's oval sits level with the bottom of the form, so he stands beside it. -->
  <div class="grid w-full grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-x-16">
    <div class="oak-stage relative mx-auto mb-12 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mb-0 lg:self-end" aria-hidden="true">
      <div class="spotlight absolute"></div>
      <OakStage client:visible className="relative" />
    </div>

    <div class="lg:col-start-1 lg:row-start-1">
      <h2 id="notify" class="pixel-heading pixel-heading-xl">First, what is your email?</h2>
      <!-- He says the rest the way he talks in the intro: his name over a message box, printing. -->
      <div class="mt-8 max-w-xl [--px:2px]">
        <p class="gba-window gba-text relative z-10 -mb-[calc(4*var(--px))] ml-[calc(4*var(--px))] inline-block">
          <span class="window-title">PROF. OAK</span>
        </p>
        <DialogBox
          client:visible
          lines={[
            `Tell me where to write and I'll let you know the moment your journey can begin, on ${RELEASE_LABEL}.`,
            "You may hear from me now and then before that, too.",
          ]}
        />
      </div>
    </div>
    <SignupForm id="signup-email" class="mt-10 max-w-xl lg:col-start-1 lg:row-start-2" />
    <CtaLinks class="mt-8 lg:col-start-1 lg:row-start-3" />
  </div>
</section>

<style>
  /* The stage is laid out in GBA pixels, drawn --s CSS pixels each. */
  .oak-stage {
    --s: 2px;
    width: calc(192 * var(--s));
    height: calc(136 * var(--s));
    /* The left 32px only holds the POKéMON's arc out of the ball; center what's left. */
    translate: calc(-16 * var(--s)) 0;
  }

  @media (min-width: 640px) {
    .oak-stage {
      --s: 3px;
    }
  }

  /* Light falling on the stage from above, the only light in the dark grass. */
  .spotlight {
    left: 0;
    right: 0;
    top: calc(-40 * var(--s));
    bottom: calc(16 * var(--s));
    clip-path: polygon(46% 0, 70% 0, 96% 100%, 22% 100%);
    background: linear-gradient(to bottom, rgb(248 248 200 / 0), rgb(248 248 200 / 0.14));
  }

</style>
