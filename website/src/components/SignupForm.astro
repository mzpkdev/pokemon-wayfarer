---
import { SIGNUP_ACTION, SIGNUP_FIELD } from "~/lib/signup"

/** Email sign-up for development updates and launch day, posted straight to the mailing list service. */
const open = SIGNUP_ACTION !== undefined
---

<form action={SIGNUP_ACTION} method="post" class="w-full max-w-xl">
  <div class="flex flex-col gap-3 sm:flex-row">
    <label for="signup-email" class="sr-only">Email address</label>
    <input
      id="signup-email"
      name={SIGNUP_FIELD}
      type="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      disabled={!open}
      class="pixel-corners min-w-0 flex-1 bg-grass-1 px-5 py-4 text-paper shadow-[inset_0_4px_0_rgb(0_16_0),inset_0_0_0_4px_var(--color-grass-2)] placeholder:text-paper/50 focus:shadow-[inset_0_0_0_4px_var(--color-logo-yellow)] focus:outline-none disabled:opacity-60"
    />
    <button
      type="submit"
      disabled={!open}
      class="pixel-corners pixel-label bg-logo-yellow px-6 pt-3 pb-4 text-logo-blue shadow-[inset_0_-4px_0_rgb(200_144_0),inset_0_4px_0_rgb(255_240_140)] transition-colors hover:bg-paper focus-visible:outline-none focus-visible:shadow-[inset_0_0_0_4px_var(--color-logo-blue)] disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:bg-logo-yellow"
    >
      {open ? "Notify me" : "Sign-ups open soon"}
    </button>
  </div>
  <p class="mt-3 text-sm text-paper/60">
    Occasional development updates and one email on launch day. Unsubscribe at any time.
  </p>
</form>
