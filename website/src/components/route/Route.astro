---
/**
 * The route the page walks down below the world map: Route 101's grass in a
 * clearing, walled in by its staggered trees wherever the screen is wider
 * than the clearing. It fades in from the dark grass above and back out at
 * the bottom in the game's 4-step warp fade, drawn top to bottom instead of
 * over time.
 */
---

<div class="route route-grass relative">
  <div class="route-wall route-trees left-0" aria-hidden="true"></div>
  <div class="route-wall route-trees right-0 -scale-x-100" aria-hidden="true"></div>
  <div class="route-fade top-0" aria-hidden="true"></div>
  <div class="route-clearing relative mx-auto">
    <slot />
  </div>
  <div class="route-fade bottom-0 rotate-180" aria-hidden="true"></div>
</div>

<style>
  .route {
    /* Phones walk the clearing edge to edge; wider screens wall it in with trees. */
    --clearing: 100%;
  }

  @media (min-width: 640px) {
    .route {
      --clearing: min(100% - 128px, 1088px);
    }
  }

  .route-clearing {
    width: var(--clearing);
  }

  .route-wall {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc((100% - var(--clearing)) / 2);
    /* A whole tree stands at the clearing's edge. */
    background-position: right 0;
  }

  /* Four steps from the dark grass above to the route, eight GBA pixels each. */
  .route-fade {
    position: absolute;
    left: 0;
    right: 0;
    height: 64px;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(8 41 0) 0 16px,
      rgb(8 41 0 / 0.75) 16px 32px,
      rgb(8 41 0 / 0.5) 32px 48px,
      rgb(8 41 0 / 0.25) 48px 64px
    );
  }
</style>
