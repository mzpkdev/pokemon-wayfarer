---
/**
 * A place on the route: its map name popup, as Heart & Soul shows one on
 * arrival (sliding down as it comes into view), then its heading outlined
 * over the grass, then whatever the place holds.
 */
type Props = {
  id: string
  /** The popup's scene, from public/game/popups. */
  popup: string
  /** The popup's name line, in capitals like the game's. */
  name: string
  title: string
  /** A patch of tall grass off to the right on wide screens, in metatiles across and down. */
  grass?: [number, number]
  class?: string
}

const { id, popup, name, title, grass, class: className } = Astro.props
---

<section aria-labelledby={id} class:list={["place relative px-4 pt-6 pb-12 sm:px-8", className]}>
  {
    grass && (
      <div
        class="route-tall-grass absolute top-6 right-8 hidden lg:block"
        style={`width: ${grass[0] * 32}px; height: ${grass[1] * 32}px`}
        aria-hidden="true"
      />
    )
  }
  <p class="place-popup pixelated grid place-items-center" style={`background-image: url(/game/popups/${popup}.png)`}>
    <span class="gba-font outline-text whitespace-nowrap">{name}</span>
  </p>
  <h2 id={id} class="place-title outline-text mt-6 max-w-3xl">{title}</h2>
  <slot />
</section>

<style>
  .place-popup {
    --px: 2px;
    width: calc(96 * var(--px));
    height: calc(40 * var(--px));
    background-size: 100% 100%;

    & .outline-text {
      --outline-dot: var(--px);
    }
  }

  @media (min-width: 640px) {
    .place-popup {
      --px: 3px;
    }
  }

  /* The heading in the game's font at twice its size, three times on wider screens. */
  .place-title {
    --outline-dot: 2px;
    font-family: var(--font-gba);
    font-size: 32px;
    line-height: 36px;
    -webkit-font-smoothing: none;
    font-smooth: never;
  }

  @media (min-width: 640px) {
    .place-title {
      --outline-dot: 3px;
      font-size: 48px;
      line-height: 54px;
    }
  }

  /* The popup slides down into place as its section comes on screen, in whole pixel steps. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .place-popup {
        animation: popup-in steps(10) both;
        animation-timeline: view();
        animation-range: entry 10% entry 60%;
      }
    }
  }

  @keyframes popup-in {
    from {
      translate: 0 calc(-24 * var(--px));
      opacity: 0;
    }
    to {
      translate: 0 0;
      opacity: 1;
    }
  }
</style>
