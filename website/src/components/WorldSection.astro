---
/**
 * The size of the world, the first highlight, reached from the title scene's
 * Poké Ball by the game's warp: a tour of the overworld in the game's own
 * tiles. Pick a start (PALLET TOWN, NEW BARK TOWN or LITTLEROOT TOWN), then a
 * button press per stop: that start's region, the whole world, the 24 Gyms
 * (tap the badges you'd win) and each league, then open to look around. The map itself lives in
 * `~/world-map`; its cards are one per stop, with what changes by start.
 */
import { type Caption, WorldTour } from "~/world-map"

// Counted from the outdoor maps the build compiles (see the website-landing
// task note): towns and cities by map type, numbered routes by number.
// Sinnoh counts too; it opens up by launch. Johto has 10 towns and cities and
// 23 routes, Kanto 10 and 25, Hoenn 16 and 34. The badges and the three
// leagues (Indigo, Hoenn and the Sevii Masters) are the game's.
const FROM_HERE = "From here everywhere else is a walk, a surf or a ferry ride away."
const captions: Caption[] = [
  {
    place: "LITTLEROOT TOWN",
    title: "It starts in one small town.",
    body: `Choose Treecko, Torchic or Mudkip. ${FROM_HERE}`,
    variants: {
      johto: {
        place: "NEW BARK TOWN",
        body: `Wake up next door to Professor Elm's lab. ${FROM_HERE}`,
      },
      kanto: {
        place: "PALLET TOWN",
        body: `Set out with a first partner from Professor Oak. ${FROM_HERE}`,
      },
    },
  },
  {
    place: "HOENN",
    title: "Then a whole region opens up.",
    body: "16 towns and cities and 34 routes, over land and sea. All of it is yours to roam.",
    variants: {
      johto: {
        place: "JOHTO",
        body: "10 towns and cities and 23 routes, over land and sea. All of it is yours to roam.",
      },
      kanto: {
        place: "KANTO",
        body: "10 towns and cities and 25 routes, over land and sea. All of it is yours to roam.",
      },
    },
  },
  {
    place: "THE WORLD",
    title: "And Hoenn is only one of them.",
    body: "Kanto, Johto, Hoenn and Sinnoh, the Sevii Islands, Sinjoh past MT. SILVER, and Alola, all on one save. Wherever you start, you can go anywhere. Three ships sail between them.",
    stats: [
      { value: "62", label: "towns and cities" },
      { value: "114", label: "routes" },
      { value: "7", label: "ports" },
    ],
    variants: {
      johto: { title: "And Johto is only one of them." },
      kanto: { title: "And Kanto is only one of them." },
    },
  },
  {
    place: "WHO LIVES HERE",
    title: "Every Pokémon, Gen I to VIII.",
    body: "All 905 of them, plus the Alolan, Galarian and Hisuian forms, out across the world.",
  },
  {
    place: "THE GYMS",
    title: "Every Gym, in any order.",
    body: "Kanto, Johto and Hoenn have eight Gyms each. Tap the badges you'd win, in any order, and meet each Leader. At eight, a league phones.",
    stats: [
      { value: "24", label: "Gym Badges" },
      { value: "3", label: "regions" },
    ],
  },
  {
    place: "INDIGO PLATEAU",
    title: "One way in: Indigo.",
    body: "It phones once it knows you: any 8 badges, one from Kanto or Johto. Each event picks five from the Gym Leaders, Elite Four and Champions of every region. Nearby ones come more willingly, whoever fought last far less, and the strongest fights last.",
  },
  {
    place: "HOENN LEAGUE",
    title: "The other way in: Ever Grande.",
    body: "It phones too: any 8 badges, one from Hoenn. Win it before or after Indigo. Its five are picked the same way, from every region, with Hoenn's own the most willing.",
  },
  {
    place: "SEVII MASTERS",
    title: "Win both, then the Masters.",
    body: "No phone call this time: walk into the lobby on Seven Island, once Indigo and Hoenn are both won.",
  },
]
---

<!--
  The warp from the title scene. The stage overlaps the title scene's last
  screen, hidden, so its top reaches the screen's top as the title scene lets
  go of the Poké Ball. On the way there the screen steps to black with the
  scroll; at black the map takes the title scene's place and the game's
  warp fade-in plays, the way the screen comes back on stepping out of a door.
  Then the player (RED, by default) sets off. The page after it rises over the map as it leaves.
-->
<div class="world-stage relative z-10 -mt-[100vh]" data-hidden>
  <section aria-labelledby="world" class="sticky top-0 h-screen min-h-[600px] overflow-hidden">
    <h2 id="world" class="sr-only">The world of Pokémon Wayfarer</h2>
    <WorldTour
      client:visible={{ rootMargin: "100%" }}
      captions={captions}
      startOn="world-tour:start"
    />
  </section>
</div>
<div class="warp pointer-events-none fixed inset-0 z-50 bg-black" aria-hidden="true"></div>

<style>
  .world-stage {
    /* A screen for the map, a little more to stay on it, then the page's grass edge rising over it. */
    height: calc(130vh + 112 * var(--scene-px));
  }

  .world-stage[data-hidden] {
    visibility: hidden;
  }

  .warp {
    opacity: 0;
  }
</style>

<script>
  import { warp } from "~/lib/warp"
  import { loadWorld } from "~/world-map/data"
  import { loadLandmarks } from "~/world-map/landmarks"

  // The map's data starts loading the first time the visitor scrolls, the
  // first sign they're heading down, so the map is there when the warp fades
  // in even on a slow connection; a visitor who never scrolls loads none of it.
  // It shares the tour's cache, so the tour picks up what's already on its way.
  addEventListener(
    "scroll",
    () => {
      void loadWorld().catch(() => {})
      void loadLandmarks()
    },
    { once: true, passive: true },
  )

  warp(document.querySelector<HTMLElement>(".world-stage")!, document.querySelector<HTMLElement>(".warp")!)
</script>
