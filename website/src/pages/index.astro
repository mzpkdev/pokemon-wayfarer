---
import SignupForm from "~/components/SignupForm.astro"
import { TitleScene } from "~/components/TitleScene"
import Layout from "~/layouts/Layout.astro"
import { FEATURES, ORIGINS, REPOSITORY_URL, STATS } from "~/lib/content"
import { RELEASE_AT, RELEASE_LABEL } from "~/lib/release"

---

<Layout title="Pokémon Wayfarer">
  <main>
    <TitleScene client:load />

    <!-- The page continues on the ground color the opening ends on, leading with the sign-up. -->
    <section aria-labelledby="notify" class="mx-auto max-w-5xl px-6 pt-12 pb-20 sm:pt-20">
      <p class="pixel-label text-logo-yellow">
        Out <time datetime={RELEASE_AT.toISOString().slice(0, 10)}>{RELEASE_LABEL}</time>
      </p>
      <h2 id="notify" class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-6xl">
        Be there on launch day
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-paper/75">
        Leave your email and we'll tell you the moment Pokémon Wayfarer is out, with the odd update on
        how it's coming along until then.
      </p>
      <div class="mt-8">
        <SignupForm />
      </div>
      <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-paper/70">
        <a href="/wayfarer-release.ics" download class="underline-offset-4 hover:text-paper hover:underline">
          Add the release to your calendar
        </a>
        <a href={REPOSITORY_URL} class="underline-offset-4 hover:text-paper hover:underline">
          Follow development on GitHub <span aria-hidden="true">→</span>
        </a>
      </p>
    </section>

    <section aria-labelledby="about" class="mx-auto max-w-5xl px-6 py-24">
      <p class="pixel-label text-logo-yellow">About</p>
      <h2 id="about" class="mt-4 max-w-3xl text-3xl font-bold tracking-tight text-balance sm:text-5xl">
        One save. Three home regions. Every road open.
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-paper/75">
        Pokémon Wayfarer is a free fan-made GBA game built on pokeemerald-expansion. Start your journey in
        Johto, Hoenn or Kanto, then sail on to the Sevii Islands and Alola, all on the same save.
      </p>
    </section>

    <section aria-labelledby="features" class="mx-auto max-w-5xl px-6 py-24">
      <p class="pixel-label text-logo-yellow">Features</p>
      <h2 id="features" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        A world that keeps moving
      </h2>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          FEATURES.map((feature) => (
            <li class="rounded-2xl bg-paper/5 p-6 ring-1 ring-paper/10">
              <img
                src={`/game/items/${feature.icon}.png`}
                alt=""
                width="48"
                height="48"
                class="pixelated size-12"
              />
              <h3 class="mt-5 font-semibold">{feature.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-paper/70">{feature.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="origins" class="mx-auto max-w-5xl px-6 py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <img
          src="/game/title/dawn.png"
          alt="Pixel art of islands at dawn, joined by dotted sea routes beneath a compass rose."
          width="240"
          height="160"
          loading="lazy"
          class="pixelated aspect-[3/2] w-full rounded-2xl ring-1 ring-paper/10"
        />
        <div>
          <p class="pixel-label text-logo-yellow">Starting regions</p>
          <h2 id="origins" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
            Where will your journey begin?
          </h2>
          <p class="mt-4 leading-relaxed text-paper/75">
            Professor Oak asks once you've chosen your name and look. Each region has its own opening, and
            wherever you start, the other two are a journey away.
          </p>
          <dl class="mt-8 divide-y divide-paper/10 border-y border-paper/10">
            {
              ORIGINS.map((origin) => (
                <div class="grid gap-1 py-5 sm:grid-cols-[8rem_1fr] sm:gap-6">
                  <dt class="font-semibold">{origin.region}</dt>
                  <dd>
                    <span class="block text-sm text-logo-yellow">{origin.town}</span>
                    <span class="mt-1 block text-paper/75">{origin.body}</span>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section aria-label="Wayfarer in numbers" class="border-y border-paper/10">
      <dl class="mx-auto grid max-w-5xl grid-cols-2 gap-x-6 gap-y-10 px-6 py-16 sm:grid-cols-5">
        {
          STATS.map((stat) => (
            <div class="flex flex-col">
              <dt class="order-2 mt-1 text-sm text-paper/70">{stat.label}</dt>
              <dd class="order-1 text-4xl font-bold tracking-tight text-logo-yellow">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <footer class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-12 text-sm text-paper/60 sm:flex-row sm:justify-between">
      <p class="max-w-md leading-relaxed">
        Pokémon Wayfarer is a free fan game. It is not affiliated with Nintendo, Creatures Inc. or GAME
        FREAK inc. Pokémon is a trademark of Nintendo.
      </p>
      <nav aria-label="Footer" class="flex gap-6">
        <a href="#top" class="hover:text-paper">Back to the title</a>
        <a href={REPOSITORY_URL} class="hover:text-paper">GitHub</a>
      </nav>
    </footer>
  </main>
</Layout>
