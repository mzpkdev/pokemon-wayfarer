---
import CtaLinks from "~/components/cta/CtaLinks.astro"
import CtaProfessor from "~/components/cta/CtaProfessor.astro"
import { DialogBox } from "~/components/DialogBox"
import Faq from "~/components/Faq.astro"
import SignupForm from "~/components/SignupForm.astro"
import { StoryShuffle } from "~/components/StoryShuffle"
import WorldSection from "~/components/WorldSection.astro"
import { TitleScene } from "~/components/TitleScene"
import Layout from "~/layouts/Layout.astro"
import { HIGHLIGHTS, LEVELS, REPOSITORY_URL } from "~/lib/content"
import { RELEASE_LABEL } from "~/lib/release"
---

<Layout title="Pokémon Wayfarer">
  <main>
    <TitleScene client:load />

    <!-- The highlights come first: the size of the world, warped to from the Poké Ball. -->
    <WorldSection />

    <!--
      The page is the nearest layer: it overlaps the end of the world map's
      pinned stretch, so its grass edge rises over the map the way the
      opening's layers cover one another. The edge lets clicks through to the
      map under it; the page's content takes them again.
    -->
    <div class="pointer-events-none relative z-20 -mt-[calc(112*var(--scene-px))]">
      <div
        class="scene-strip h-[calc(112*var(--scene-px))] bg-[url(/game/page/edge.png)]"
        aria-hidden="true"
      >
      </div>

      <!-- Content starts over the edge's solid ground, so it follows the plants closely. -->
      <div
        class="pointer-events-auto relative -mt-[calc(12*var(--scene-px))] overflow-x-clip bg-ground"
      >
        <!-- Then PROF. OAK asks for your email. -->
        <CtaProfessor />

        <!--
          What the map can't show: how an open world stays fair, then the two
          things that set Wayfarer apart, each drawn the way the game draws it.
        -->
        <section aria-labelledby="open-world" class="relative mx-auto max-w-5xl px-6 py-16">
          <p class="pixel-label text-logo-yellow">Open world</p>
          <h2 id="open-world" class="pixel-heading mt-4">Go anywhere. There's always a way.</h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-paper/80">
            Every region is open from the first step, in any order. Wayfarer doesn't take every obstacle
            away: a road can still be blocked, a sea too wide or a door shut. But a blocked road is never the
            only one. There's always another way around.
          </p>

          <div class="mt-16 grid grid-cols-[minmax(0,1fr)] items-center gap-10 lg:grid-cols-[1fr_auto] lg:gap-16">
            <div>
              <p class="pixel-label text-logo-yellow">Story</p>
              <h3 class="pixel-heading mt-3">Every story, in your order.</h3>
              <p class="mt-5 text-lg leading-relaxed text-paper/80">
                Open worlds usually make you pick between a story and your freedom. Wayfarer keeps both. The
                original games' stories, from Mt. Moon to the Radio Tower, are split into standalone beats,
                and each one makes sense whenever you reach it.
              </p>
              <p class="mt-4 leading-relaxed text-paper/70">
                Walk into Slowpoke Well first or last: it still opens at its start and ends with the Rockets
                gone.
              </p>
            </div>
            <div class="pixel-corners pixel-panel grid place-items-center px-10 py-8 sm:px-14 sm:py-10">
              <StoryShuffle client:visible />
            </div>
          </div>

          <div class="mt-16 grid grid-cols-[minmax(0,1fr)] items-center gap-10 lg:grid-cols-[auto_1fr] lg:gap-16">
            <div class="lg:order-2">
              <p class="pixel-label text-logo-yellow">Field moves</p>
              <h3 class="pixel-heading mt-3">Surf the moment you catch it.</h3>
              <p class="mt-5 text-lg leading-relaxed text-paper/80">
                Wild Pokémon can already know field moves when you catch them. Find one that knows Surf and
                the sea is open, with no HM and no badge.
              </p>
              <p class="mt-4 leading-relaxed text-paper/70">
                Find the HM later and you won't even need to teach it: it works whenever someone in your
                party could learn the move.
              </p>
            </div>
            <!-- The game's own prompt at the water's edge, with its YES/NO menu. -->
            <div
              class="pixel-corners pixel-panel grid place-items-center px-4 py-8 sm:px-10 sm:py-10 lg:order-1"
              aria-hidden="true"
            >
              <div class="flex w-full flex-col sm:w-[calc(232*var(--px))] items-end gap-[calc(2*var(--px))] [--px:2px]">
                <div class="gba-window gba-text">
                  <span class="block">▶YES</span>
                  <span class="block pl-[calc(8*var(--px))]">NO</span>
                </div>
                <DialogBox
                  client:visible
                  lines={["The water is dyed a deep blue…", "Would you like to SURF?"]}
                  className="w-full"
                />
              </div>
            </div>
          </div>

          <div class="mt-16 grid grid-cols-[minmax(0,1fr)] items-center gap-10 lg:grid-cols-[1fr_auto] lg:gap-16">
            <div>
              <p class="pixel-label text-logo-yellow">Level scaling</p>
              <h3 class="pixel-heading mt-3">The world keeps pace.</h3>
              <p class="mt-5 text-lg leading-relaxed text-paper/80">
                Every badge, from any region, raises your level cap, and the wild Pokémon follow it by where
                they live. Roads fall further behind you with each badge, the grass off the road sits a step
                above, and places far from home meet you at your cap all game.
              </p>
              <p class="mt-4 leading-relaxed text-paper/70">
                The cap is soft: past it, Pokémon earn half the experience and may not obey. Trainers, Gym
                Leaders and the leagues scale too, and an evolved form only appears once it's at the level to
                evolve.
              </p>
            </div>
            <figure class="pixel-corners pixel-panel grid justify-items-center gap-4 px-4 py-8 sm:px-10 sm:py-10">
              <div class="gba-window [--px:1px] sm:[--px:2px]">
                <table class="gba-text">
                <caption class="sr-only">Wild Pokémon levels and your level cap by badges earned</caption>
                <thead>
                  <tr>
                    <th scope="col" class="gba-text gba-text-blue pr-[calc(8*var(--px))] text-left font-normal">BADGES</th>
                    {
                      LEVELS.badges.map((badges) => (
                        <th scope="col" class="gba-text gba-text-blue px-[calc(4*var(--px))] text-right font-normal">
                          {badges}
                        </th>
                      ))
                    }
                  </tr>
                </thead>
                <tbody>
                  {
                    LEVELS.rows.map((row) => (
                      <tr>
                        <th scope="row" class="pr-[calc(8*var(--px))] text-left font-normal">
                          {row.label}
                        </th>
                        {row.levels.map((level) => (
                          <td class="px-[calc(4*var(--px))] text-right">{level}</td>
                        ))}
                      </tr>
                    ))
                  }
                </tbody>
              </table>
              </div>
              <figcaption class="text-center text-sm text-paper/60">
                Levels today, still being tuned before release.
              </figcaption>
            </figure>
          </div>
        </section>

        <!-- The tour in short, for anyone who scrolled past it. -->
        <section aria-labelledby="highlights" class="relative mx-auto max-w-5xl px-6 py-16">
          <p class="pixel-label text-logo-yellow">The short version</p>
          <h2 id="highlights" class="pixel-heading mt-4">A world that keeps moving</h2>
          <ul class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2">
            {
              HIGHLIGHTS.map((highlight) => (
                <li class="flex gap-4">
                  <div class="pixel-corners pixel-panel grid size-16 shrink-0 place-items-center">
                    <img
                      src={`/game/items/${highlight.icon}.png`}
                      alt=""
                      width="48"
                      height="48"
                      class="pixelated size-12"
                    />
                  </div>
                  <div>
                    <h3 class="font-semibold">{highlight.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-paper/75">{highlight.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </section>

        <Faq />

        <!-- One more chance to sign up, for anyone the questions won over. -->
        <section aria-labelledby="notify-again" class="relative mx-auto max-w-3xl px-6 py-16">
          <p class="pixel-label text-logo-yellow">{RELEASE_LABEL}</p>
          <h2 id="notify-again" class="pixel-heading mt-4">Your journey is almost ready.</h2>
          <p class="mt-6 text-lg leading-relaxed text-paper/80">
            Leave your email and Professor Oak will write the moment it begins.
          </p>
          <SignupForm id="signup-email-again" class="mt-8" />
          <CtaLinks class="mt-8" />
        </section>

        <footer class="relative mx-auto flex max-w-5xl flex-col gap-6 px-6 pt-16 pb-10 text-sm text-paper/70 sm:flex-row sm:justify-between">
          <p class="max-w-md leading-relaxed">
            Pokémon Wayfarer is a free fan game. It is not affiliated with Nintendo, Creatures Inc. or GAME
            FREAK inc. Pokémon is a trademark of Nintendo.
          </p>
          <nav aria-label="Footer" class="flex gap-6">
            <a href="#top" class="hover:text-paper">Back to the title</a>
            <a href={REPOSITORY_URL} class="hover:text-paper">GitHub</a>
          </nav>
        </footer>
      </div>

      <!-- The title screen's meadow closes the page, with a Torchic running through it. -->
      <div class="relative overflow-hidden">
        <div
          class="scene-strip h-[calc(64*var(--scene-px))] bg-ground bg-[url(/game/page/meadow.png)]"
          aria-hidden="true"
        >
        </div>
        <div class="torchic-path absolute bottom-[calc(14*var(--scene-px))] left-0" aria-hidden="true">
          <div
            class="sprite torchic bg-[url(/game/sprites/torchic.png)]"
            style="--size: 32; --sprite-px: var(--scene-px)"
          >
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  @keyframes drift {
    from {
      translate: -120px 0;
    }
    to {
      translate: calc(100vw + 120px) 0;
    }
  }

  /* TORCHIC runs rightward (its sprite faces left), cycling frames 0, 1, 2, 1. */
  .torchic-path {
    animation: drift 16s linear infinite;
  }

  .torchic {
    scale: -1 1;
    animation: torchic-run 0.2s steps(1) infinite;
  }

  @keyframes torchic-run {
    0% {
      background-position-y: 0;
    }
    25% {
      background-position-y: calc(-32 * var(--scene-px));
    }
    50% {
      background-position-y: calc(-64 * var(--scene-px));
    }
    75% {
      background-position-y: calc(-32 * var(--scene-px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .torchic-path,
    .torchic {
      animation: none;
    }

    .torchic-path {
      display: none;
    }
  }
</style>
