---
import CtaLinks from "~/components/cta/CtaLinks.astro"
import CtaProfessor from "~/components/cta/CtaProfessor.astro"
import { DialogBox } from "~/components/DialogBox"
import Faq from "~/components/Faq.astro"
import { RightNow } from "~/components/RightNow"
import SignupForm from "~/components/SignupForm.astro"
import { StartMenu } from "~/components/StartMenu"
import { StoryShuffle } from "~/components/StoryShuffle"
import WorldSection from "~/components/WorldSection.astro"
import { TitleScene } from "~/components/TitleScene"
import Layout from "~/layouts/Layout.astro"
import { BagScreen } from "~/components/BagScreen"
import Ledge from "~/components/route/Ledge.astro"
import Place from "~/components/route/Place.astro"
import Route from "~/components/route/Route.astro"
import WorldCard from "~/components/WorldCard.astro"
import { HIGHLIGHTS, LEVELS, REPOSITORY_URL } from "~/lib/content"
import { RELEASE_LABEL } from "~/lib/release"
---

<Layout title="Pokémon Wayfarer">
  <main>
    <TitleScene client:load />

    <!-- The START menu, in the corner once the title screen is behind. -->
    <StartMenu client:idle />

    <!-- The highlights come first: the size of the world, warped to from the Poké Ball. -->
    <WorldSection />

    <!--
      The page is the nearest layer: it overlaps the end of the world map's
      pinned stretch, so its grass edge rises over the map the way the
      opening's layers cover one another. The edge lets clicks through to the
      map under it; the page's content takes them again.
    -->
    <div class="pointer-events-none relative z-20 -mt-[calc(112*var(--scene-px))]">
      <div
        class="scene-strip h-[calc(112*var(--scene-px))] bg-[url(/game/page/edge.png)]"
        aria-hidden="true"
      >
      </div>

      <!-- Content starts over the edge's solid ground, so it follows the plants closely. -->
      <div
        class="pointer-events-auto relative -mt-[calc(12*var(--scene-px))] overflow-x-clip bg-ground"
      >
        <!-- Then PROF. OAK asks for your email. -->
        <CtaProfessor />

        <!--
          Out of the dark grass and onto the route: every place below is one
          of the game's screens, met under its map name popup.
        -->
        <Route>
          <!--
            The world as it is this moment, on the clock the map runs on: proof
            the map's ships, train and Gym Leaders weren't a loop for the tour.
          -->
          <Place id="right-now" popup="ocean" name="RIGHT NOW" grass={[7, 3]} title="The world doesn't wait for you.">
            <div class="gba-window gba-text mt-8 max-w-3xl [--px:2px]">
              <p>
                The ships sail their loops, the Magnet Train runs its line and every Gym Leader keeps to their
                own day, whether you're there to see it or not.
              </p>
              <p class="mt-[1lh]">This is where everyone is right now, on the same clock as the map above.</p>
            </div>
            <div class="mt-10">
              <RightNow client:visible />
            </div>
          </Place>

          <Ledge />

          <!--
            What the map can't show: how an open world stays fair, then the
            things that set Wayfarer apart, each drawn the way the game draws it.
          -->
          <Place id="open-world" popup="kanto" name="OPEN WORLD" grass={[5, 4]} title="Go anywhere. There's always a way.">
            <div class="gba-window gba-text mt-8 max-w-3xl [--px:2px]">
              <p>
                Every region is open, in any order, with no badge in the way. A road can still be blocked, a
                sea too wide or a door shut. But a blocked road is never the only one: there's always another
                way around.
              </p>
            </div>

            <div class="mt-16 grid grid-cols-[minmax(0,1fr)] items-center gap-10 lg:gap-12 lg:grid-cols-[minmax(0,1fr)_auto]">
              <div class="gba-window gba-text [--px:2px]">
                <h3 class="window-title">STORY</h3>
                <p class="mt-[0.5lh] text-ink">Every story, in your order.</p>
                <p class="mt-[1lh]">
                  The original stories, from Mt. Moon to the Radio Tower, are split into standalone beats, and
                  each one makes sense whenever you reach it.
                </p>
                <p class="mt-[1lh]">
                  Walk into Slowpoke Well first or last: it still opens at its start and ends with the Rockets
                  gone.
                </p>
              </div>
              <div class="grid place-items-center">
                <StoryShuffle client:visible />
              </div>
            </div>

            <div class="mt-16 grid grid-cols-[minmax(0,1fr)] items-center gap-10 lg:gap-12 lg:grid-cols-[auto_minmax(0,1fr)]">
              <div class="gba-window gba-text [--px:2px] lg:order-2">
                <h3 class="window-title">FIELD MOVES</h3>
                <p class="mt-[0.5lh]">Surf the moment you catch it.</p>
                <p class="mt-[1lh]">
                  Wild Pokémon can already know field moves when you catch them. Find one that knows Surf and
                  the sea is open, with no HM and no badge.
                </p>
                <p class="mt-[1lh]">
                  Find the HM later and you won't even need to teach it: it works whenever someone in your
                  party could learn the move.
                </p>
              </div>
              <!-- The game's own prompt at the water's edge, with its YES/NO menu, over a pond. -->
              <div class="pond grid place-items-center px-4 py-10 sm:px-8 lg:order-1" aria-hidden="true">
                <div class="flex w-full flex-col items-end gap-[calc(2*var(--px))] [--px:2px] sm:w-[calc(232*var(--px))]">
                  <div class="gba-window gba-text">
                    <span class="block">▶YES</span>
                    <span class="block pl-[calc(8*var(--px))]">NO</span>
                  </div>
                  <DialogBox
                    client:visible
                    lines={["The water is dyed a deep blue…", "Would you like to SURF?"]}
                    className="w-full"
                  />
                </div>
              </div>
            </div>

            <div class="mt-16 grid grid-cols-[minmax(0,1fr)] items-center gap-10 lg:gap-12 lg:grid-cols-[minmax(0,1fr)_auto]">
              <div class="gba-window gba-text [--px:2px]">
                <h3 class="window-title">LEVEL SCALING</h3>
                <p class="mt-[0.5lh]">The world keeps pace.</p>
                <p class="mt-[1lh]">
                  Every badge, from any region, raises your level cap, and wild Pokémon follow it by where they
                  live. Roads fall further behind you with each badge, the grass off the road sits a step above,
                  and places far from home meet you at your cap all game.
                </p>
                <p class="mt-[1lh]">
                  The cap is soft: past it, Pokémon earn half the experience and may not obey. Trainers, Gym
                  Leaders and the leagues scale too.
                </p>
              </div>
              <!-- Whole GBA pixels at 2x. Phones drop the 4-badge column and tighten the columns, to fit. -->
              <figure class="grid justify-items-center gap-3">
                <div class="gba-window [--px:2px]">
                  <table class="gba-text">
                    <caption class="sr-only">Wild Pokémon levels and your level cap by badges earned</caption>
                    <thead>
                      <tr>
                        <th scope="col" class="gba-text gba-text-blue pr-[calc(6*var(--px))] sm:pr-[calc(8*var(--px))] text-left font-normal">BADGES</th>
                        {
                          LEVELS.badges.map((badges, column) => (
                            <th
                              scope="col"
                              class:list={[
                                "gba-text gba-text-blue px-[calc(3*var(--px))] sm:px-[calc(4*var(--px))] text-right font-normal",
                                column === LEVELS.hiddenOnPhones && "hidden sm:table-cell",
                              ]}
                            >
                              {badges}
                            </th>
                          ))
                        }
                      </tr>
                    </thead>
                    <tbody>
                      {
                        LEVELS.rows.map((row) => (
                          <tr>
                            <th scope="row" class="pr-[calc(6*var(--px))] sm:pr-[calc(8*var(--px))] text-left font-normal whitespace-nowrap">
                              {row.label}
                            </th>
                            {row.levels.map((level, column) => (
                              <td
                                class:list={[
                                  "px-[calc(3*var(--px))] sm:px-[calc(4*var(--px))] text-right",
                                  column === LEVELS.hiddenOnPhones && "hidden sm:table-cell",
                                ]}
                              >
                                {level}
                              </td>
                            ))}
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
                <figcaption class="gba-font outline-text [--outline-dot:var(--px)] [--px:2px]">Levels today, still being tuned.</figcaption>
              </figure>
            </div>
          </Place>

          <Ledge />

          <!-- The tour in short, for anyone who scrolled past it: the world's card, then the BAG. -->
          <Place id="highlights" popup="town" name="IN SHORT" grass={[8, 2]} title="A world that keeps moving.">
            <WorldCard />
            <div class="mt-10">
              <BagScreen client:visible items={HIGHLIGHTS} />
            </div>
          </Place>

          <Ledge />

          <Faq />

          <Ledge />

          <!-- One more chance to sign up, for anyone the questions won over. -->
          <Place id="notify-again" popup="cherry" name={RELEASE_LABEL} grass={[6, 3]} title="Your journey is almost ready.">
            <div class="mt-8 grid max-w-3xl gap-6">
              <div class="gba-window gba-text [--px:2px]">
                <p>Leave your email and Professor Oak will write the moment it begins.</p>
              </div>
              <SignupForm id="signup-email-again" />
              <CtaLinks />
            </div>
          </Place>
        </Route>

        <footer class="relative mx-auto flex max-w-5xl flex-col gap-8 px-6 pt-16 pb-10 sm:flex-row sm:items-start sm:justify-between">
          <p class="gba-text gba-text-light max-w-2xl [--px:2px]">
            Pokémon Wayfarer is a free fan game. It is not affiliated with Nintendo, Creatures Inc. or GAME
            FREAK inc. Pokémon is a trademark of Nintendo.
          </p>
          <nav aria-label="Footer" class="gba-text gba-text-light flex shrink-0 gap-8 [--px:2px]">
            <a href="#top" class="footer-link">BACK TO THE TITLE</a>
            <a href={REPOSITORY_URL} class="footer-link">GITHUB</a>
          </nav>
        </footer>
      </div>

      <!-- The title screen's meadow closes the page, with a Torchic running through it. -->
      <div class="relative overflow-hidden">
        <div
          class="scene-strip h-[calc(64*var(--scene-px))] bg-ground bg-[url(/game/page/meadow.png)]"
          aria-hidden="true"
        >
        </div>
        <div class="torchic-path absolute bottom-[calc(14*var(--scene-px))] left-0" aria-hidden="true">
          <div
            class="sprite torchic bg-[url(/game/sprites/torchic.png)]"
            style="--size: 32; --sprite-px: var(--scene-px)"
          >
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Route 103's water, with a pixel-stepped shore. */
  .pond {
    background: url("/game/route/water.png") 0 0 / 32px 32px repeat;
    image-rendering: pixelated;
    box-shadow:
      inset 0 0 0 4px rgb(48 88 176),
      inset 0 0 0 8px rgb(152 200 248);
    clip-path: polygon(
      0 16px, 8px 16px, 8px 8px, 16px 8px, 16px 0,
      calc(100% - 16px) 0, calc(100% - 16px) 8px, calc(100% - 8px) 8px, calc(100% - 8px) 16px, 100% 16px,
      100% calc(100% - 16px), calc(100% - 8px) calc(100% - 16px), calc(100% - 8px) calc(100% - 8px), calc(100% - 16px) calc(100% - 8px), calc(100% - 16px) 100%,
      16px 100%, 16px calc(100% - 8px), 8px calc(100% - 8px), 8px calc(100% - 16px), 0 calc(100% - 16px)
    );
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    --ink: var(--color-logo-yellow);
    outline: none;
  }

  @keyframes drift {
    from {
      translate: -120px 0;
    }
    to {
      translate: calc(100vw + 120px) 0;
    }
  }

  /* TORCHIC runs rightward (its sprite faces left), cycling frames 0, 1, 2, 1. */
  .torchic-path {
    animation: drift 16s linear infinite;
  }

  .torchic {
    scale: -1 1;
    animation: torchic-run 0.2s steps(1) infinite;
  }

  @keyframes torchic-run {
    0% {
      background-position-y: 0;
    }
    25% {
      background-position-y: calc(-32 * var(--scene-px));
    }
    50% {
      background-position-y: calc(-64 * var(--scene-px));
    }
    75% {
      background-position-y: calc(-32 * var(--scene-px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .torchic-path,
    .torchic {
      animation: none;
    }

    .torchic-path {
      display: none;
    }
  }
</style>
