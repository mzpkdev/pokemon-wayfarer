{
  "name": "@wayfarer/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "assets": "node scripts/game-assets.mjs",
    "sketch:world": "node scripts/sketch/world-data.mjs public/sketch/world",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "node -e \"for (const d of ['dist', '.astro']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@ark-ui/react": "^5.40.0",
    "@astrojs/react": "^7.1.2",
    "astro": "^7.4.4",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "opentype.js": "1.3.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
