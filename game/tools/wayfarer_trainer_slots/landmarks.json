  "allowed_phrases": [
    {
      "pattern": "(?:[Tt]he )?GYM BADGES?",
      "reason": "the player's badges, not a building"
    },
    {
      "pattern": "GYM LEADER(?:S|’s)?",
      "reason": "a role, not a building"
    },
    {
      "pattern": "GYMS",
      "reason": "a plural, general mention"
    },
    {
      "pattern": "LEAGUE CHAMP(?:ION)?",
      "reason": "a title, not a place"
    },
    {
      "pattern": "(?:going|heading|headed) (?:to|for) the GYM",
      "reason": "asks where the player is headed; names no particular gym"
    },
    {
      "pattern": "on the POKéMON LEAGUE challenge",
      "reason": "the player's goal, true anywhere"
    },
    {
      "pattern": "do well at the LEAGUE",
      "reason": "a prediction about the player, true anywhere"
    },
    {
      "pattern": "aim for the POKéMON LEAGUE",
      "reason": "advice about the player's goal, true anywhere"
    },
    {
      "pattern": "mount a POKéMON LEAGUE challenge",
      "reason": "the speaker's own goal, true anywhere"
    },
    {
      "pattern": "sights on the POKéMON LEAGUE",
      "reason": "the player's goal, true anywhere"
    },
    {
      "pattern": "win your way through the POKéMON LEAGUE",
      "reason": "general advice, true anywhere"
    },
    {
      "pattern": "catch more POKéMON at the SAFARI",
      "reason": "the speaker's plan, not where it stands"
    },
    {
      "pattern": "before entering any CONTEST",
      "reason": "a plan, not a place"
    }
  ],
  "capital_stems": [
    "VICTORY"
  ],
  "spot_phrases": [
    "\\b(?:rests?|sleeps?|lived|lives|lies|buried|dwells?) here\\b",
    "\\bsleep(?:ing)? (?:inside|within) here\\b",
    "\\b(?:inside|within) here\\b",
    "\\b(?:development|construction|digging|excavation) here\\b",
    "\\b(?:ends?|lost|fell|failed|stops?) here\\b",
    "\\bthis is where\\b",
    "\\b(?:place|spot|area|building|tower|cave) nearby\\b",
    "\\bthe (?:ones?|rest) here\\b",
    "\\bfrom here\\b(?<=hill from here)",
    "\\b(?:further|farther) ahead\\b",
    "\\bfind (?:us|them) here\\b",
    "\\bexploring here\\b",
    "\\bgiant rock\\b"
  ]
