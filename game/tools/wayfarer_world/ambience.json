  "beats": [
    {"id": "look_around", "class": "idle", "when": ["walking"], "who": {"tags_none": ["stoic"]},
     "steps": ["wait 2", "face left", "wait 3", "face right", "wait 3", "look_back"]},
    {"id": "hum", "class": "idle", "when": ["walking"], "who": {"tags_any": ["cheerful"]},
     "flags": ["keep_walking"],
     "steps": ["emote music"]},
    {"id": "stretch", "class": "idle", "when": ["walking", "outdoors"], "who": {"tags_any": ["athletic"]},
     "steps": ["wait 1", "jump", "wait 1"]},
    {"id": "skywatch", "class": "idle", "when": ["walking", "outdoors"],
     "who": {"tags_any": ["curious", "mystic", "dreamy"]},
