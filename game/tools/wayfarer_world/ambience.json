    {"id": "player_lingers", "class": "react", "when": [{"player_adjacent_ticks": 12}],
     "flags": ["once_per_episode"],
     "steps": ["emote ?"]},
    {"id": "greet_colleague", "class": "react", "when": [{"notable_within": 3, "relation": "colleague"}],
