    {"id": "doze", "class": "idle", "when": ["dwelling", {"activity": ["relax", "train"]}],
     "who": {"tags_any": ["dreamy"]},
     "steps": ["emote pensive", "wait 16", "emote !"]},
    {"id": "admire_water", "class": "idle", "when": [{"facing": "water"}], "who": {"tags_any": ["water"]},
