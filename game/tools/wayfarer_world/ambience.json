               "step ahead"]},
    {"id": "water_wait", "class": "idle", "when": [{"spot": ["water_edge"]}, {"facing": "water"}],
     "steps": ["emote …", "wait 8"]},
    {"id": "counter_heal", "class": "idle", "when": [{"spot": ["center_counter"]}],
     "steps": ["bow nurse", "emote music", "wait 6"]},
    {"id": "shelf_compare", "class": "idle", "when": [{"spot": ["store"]}],
     "steps": ["emote ?", "wait 4", "face left", "wait 2", "face target"]},
    {"id": "slots_result", "class": "idle", "when": [{"spot": ["game_corner"]}],
     "steps": ["wait 4", "emote !!/X"]},
    {"id": "chat_talk", "class": "idle", "when": [{"spot": ["npc_chat"]}],
