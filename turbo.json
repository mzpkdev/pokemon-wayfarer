{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["SKYEMU_ROM", "SKYEMU_SYMS"],
      "outputs": []
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["SKYEMU_ROM", "SKYEMU_SYMS"],
      "outputs": []
    },
    "smoke": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["SKYEMU_ROM", "SKYEMU_SYMS"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
