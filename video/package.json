{
  "name": "@wayfarer/video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "voice": "node scripts/voice.mjs",
    "actors": "node scripts/actors.mjs",
    "scout": "node scripts/scout.mjs",
    "frames": "node scripts/frames.mjs",
    "render": "node scripts/render.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "node -e \"for (const d of ['dist', 'out']) require('node:fs').rmSync(d, { recursive: true, force: true })\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@wayfarer/website": "workspace:*",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "1.58.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
